# ──────────────────────────────────────────────
# Week 5 Flask API — Environment Variables
# ──────────────────────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — it will NEVER be committed.
# .env.example IS committed — it documents what variables exist.
#
# ──────────────────────────────────────────────

# SQLite database path (relative to the api/ directory).
# The container's volume mount maps ./data to /app/data.
DB_PATH=data/chat.db

# Flask secret key — used for JWT signing and verification.
# This NEVER leaves the server. It is NOT the user-facing password.
# Generate a secure one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# Chat password — the password users enter on the frontend to log in.
# On startup, the server hashes this and stores the hash in the SQLite
# database. The plaintext password is never stored.
# Change this to something unique for your deployment.
CHAT_PASSWORD=change-me