FROM docker.io/library/python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server.py .
RUN mkdir -p /app/data
EXPOSE 8080

# gunicorn is a production WSGI server.
# Flask's built-in server is single-threaded and not suitable for production.
# --workers 3 runs 3 processes to handle concurrent requests.
# app:app means "the 'app' variable in 'server.py'"
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "3", "--timeout", "300", "server:app"]